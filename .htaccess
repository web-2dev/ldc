RewriteEngine On
RewriteBase /

# Désactivation de l'indexation des répertoires (= afficher l'arborescence dans les navigateurs)
Options -Indexes

# La directive RedirectMatch 403 renvoie directement une erreur 403
RedirectMatch 403 ^/data/

# # Si le fichier ou le dossier n'existe pas , redirige vers index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# # Règles de réécriture d'URL :
RewriteRule ^.*$ / [L,QSA,R=301]

# # Si l'URL correspond à /blog/something ou /article/123, autorisez-la
# RewriteRule ^(mona|didier)/?[a-zA-Z0-9\-]*$ index.php [L,QSA]

